# RiskNexus backend — example environment file.
#
# Copy to backend/.env ONLY if you need to override something.
# Every path/setting below has a correct default inside the package, and an empty
# value is treated exactly like an unset one. Leave lines commented to use defaults.

# ── Paths (use absolute paths if you override; relative paths resolve from the working directory)
# MODEL_ARTIFACT_DIR=/abs/path/to/artifacts/deployment_v2   # default: <backend>/artifacts/deployment_v2
# CANONICAL_DATA_DIR=/abs/path/to/phase6                   # default: <backend>/data/phase6 (must contain enhanced_phase6_corrected.csv)
# DEMO_DATA_DIR=/abs/path/to/demo_data                     # default: <backend>/demo_data

# ── Dataset safety ────────────────────────────────────────────────────────────
# VERIFY_DATASET_SHA256=true   # startup fails if the dataset is not the frozen file
# ALLOW_DEMO_DATA=false        # true = DEV ONLY: serve 4 demo projects if the dataset is missing

# ── Supabase Storage (used ONLY if the local canonical CSV is missing) ────────
# The CSV is downloaded once at startup into DATASET_CACHE_DIR, SHA-256 verified,
# then loaded. SERVER-SIDE SECRET: never put the service-role key in the frontend
# or commit a real value here.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=RiskNexus
# SUPABASE_OBJECT_PATH=enhanced_phase6_corrected.csv
# DATASET_CACHE_DIR=/abs/path/to/cache           # default: <backend>/.dataset_cache
# DATASET_DOWNLOAD_TIMEOUT_SECONDS=120

# ── API ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
REQUEST_MAX_SIZE_BYTES=1048576

# ── Operational priority queue ───────────────────────────────────────────────
SCHEDULE_ALERT_TOP_N=50
SCHEDULE_ALERT_TOP_PERCENT=10.0

# ── Gemini (optional; without a key /ai/explain returns a template explanation) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15
