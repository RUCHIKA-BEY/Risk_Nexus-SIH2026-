{
 "AssessRequest": {
  "properties": {
   "as_of": {
    "description": "Reporting month T, 'YYYY-MM' or 'YYYY-MM-DD'. Only rows <= T are used.",
    "title": "As Of",
    "type": "string"
   },
   "include_benchmark": {
    "default": true,
    "title": "Include Benchmark",
    "type": "boolean"
   },
   "include_fcm": {
    "default": true,
    "title": "Include Fcm",
    "type": "boolean"
   },
   "project_id": {
    "title": "Project Id",
    "type": "string"
   },
   "scenario_overrides": {
    "additionalProperties": {
     "type": "number"
    },
    "title": "Scenario Overrides",
    "type": "object"
   },
   "top_n": {
    "default": 5,
    "maximum": 14,
    "minimum": 1,
    "title": "Top N",
    "type": "integer"
   }
  },
  "required": [
   "project_id",
   "as_of"
  ],
  "title": "AssessRequest",
  "type": "object"
 },
 "ExplainRequest": {
  "properties": {
   "as_of": {
    "description": "Reporting month T, 'YYYY-MM' or 'YYYY-MM-DD'. Only rows <= T are used.",
    "title": "As Of",
    "type": "string"
   },
   "project_id": {
    "title": "Project Id",
    "type": "string"
   },
   "targets": {
    "items": {
     "enum": [
      "cost",
      "schedule",
      "compound"
     ],
     "type": "string"
    },
    "title": "Targets",
    "type": "array"
   },
   "top_n": {
    "default": 5,
    "maximum": 14,
    "minimum": 1,
    "title": "Top N",
    "type": "integer"
   }
  },
  "required": [
   "project_id",
   "as_of"
  ],
  "title": "ExplainRequest",
  "type": "object"
 },
 "FCMGraphResponse": {
  "$defs": {
   "FCMEdgeState": {
    "properties": {
     "basis": {
      "title": "Basis",
      "type": "string"
     },
     "influence": {
      "description": "final_state(source) * weight",
      "title": "Influence",
      "type": "number"
     },
     "relationship": {
      "enum": [
       "positive",
       "negative"
      ],
      "title": "Relationship",
      "type": "string"
     },
     "source": {
      "title": "Source",
      "type": "string"
     },
     "target": {
      "title": "Target",
      "type": "string"
     },
     "weight": {
      "title": "Weight",
      "type": "number"
     }
    },
    "required": [
     "source",
     "target",
     "weight",
     "relationship",
     "basis",
     "influence"
    ],
    "title": "FCMEdgeState",
    "type": "object"
   }
  },
  "properties": {
   "activation": {
    "title": "Activation",
    "type": "string"
   },
   "config_version": {
    "title": "Config Version",
    "type": "string"
   },
   "damping": {
    "title": "Damping",
    "type": "number"
   },
   "disclaimer": {
    "default": "Expert-defined DRAFT fuzzy cognitive map (not domain-approved). It is a scenario and reasoning aid, separate from the ML prediction. Its states are not probabilities and its pathways do not establish causality.",
    "title": "Disclaimer",
    "type": "string"
   },
   "edges": {
    "items": {
     "$ref": "#/$defs/FCMEdgeState"
    },
    "title": "Edges",
    "type": "array"
   },
   "input_normalisation": {
    "additionalProperties": {
     "type": "string"
    },
    "title": "Input Normalisation",
    "type": "object"
   },
   "node_order": {
    "items": {
     "type": "string"
    },
    "title": "Node Order",
    "type": "array"
   },
   "nodes": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "Nodes",
    "type": "array"
   },
   "review_status": {
    "title": "Review Status",
    "type": "string"
   },
   "update_rule": {
    "title": "Update Rule",
    "type": "string"
   },
   "weight_matrix": {
    "description": "W[i][j] = weight of edge node_order[i] -> node_order[j]",
